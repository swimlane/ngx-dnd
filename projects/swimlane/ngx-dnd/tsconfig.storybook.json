{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "baseUrl": "../../../",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@swimlane/ngx-dnd": ["projects/swimlane/ngx-dnd/src/public_api"],
      "@swimlane/ngx-dnd/*": ["projects/swimlane/ngx-dnd/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", ".storybook/*.ts"],
  "exclude": ["src/test.ts", "**/*.spec.ts"]
}
