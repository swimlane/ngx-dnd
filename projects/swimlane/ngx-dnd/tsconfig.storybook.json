{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "baseUrl": "../../../",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@swimlane/ngx-dnd": ["projects/swimlane/ngx-dnd/src/public_api"],
      "@swimlane/ngx-dnd/*": ["projects/swimlane/ngx-dnd/src/*"],
      "@ngx-dnd-demo/builder": ["src/app/builder/builder.module"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    ".storybook/*.ts",
    "../../../src/app/builder/builder.component.ts",
    "../../../src/app/builder/builder.module.ts"
  ],
  "exclude": ["src/test.ts", "**/*.spec.ts"]
}
